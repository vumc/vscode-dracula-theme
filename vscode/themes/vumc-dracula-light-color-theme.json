      "settings": { "foreground": "#635D97", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.list"],
      "settings": { "foreground": "#036A96" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.diff"],
      "settings": { "foreground": "#5b9c54" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.diff"],
      "settings": { "foreground": "#db756a" }
    },
    {
      "scope": ["markup.changed", "markup.changed.diff"],
      "settings": { "foreground": "#4f97b6" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#CB3A2A" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#1F1F1F", "fontStyle": "strikethrough" }
    },
    {
      "scope": ["meta.diff", "meta.diff.header"],
      "settings": { "foreground": "#635D97" }
    },
    {
      "scope": ["source.json meta.structure.dictionary.json support.type.property-name.json", "source.json string.quoted.double support.type.property-name.json"],
      "settings": { "foreground": "#036A96" }
    },
    {
      "scope": ["meta.property-list meta.property.css support.type.property-name.css"],
      "settings": { "foreground": "#036A96" }
    },
    {
      "scope": ["entity.other.attribute-name.html"],
      "settings": { "foreground": "#14710A", "fontStyle": "italic" }
    },
    {
      "scope": ["text.html entity.name.tag", "text.xml entity.name.tag"],
      "settings": { "foreground": "#A3144D" }
    },
    {
      "scope": ["source.python meta.function.decorator", "source.python support.type.exception"],
      "settings": { "foreground": "#14710A" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#14710A", "fontStyle": "italic" }
    },
    {
      "scope": ["meta.import keyword", "keyword.control.import", "keyword.control.from", "keyword.control.export"],
      "settings": { "foreground": "#A3144D" }
    },
    {
      "scope": ["meta.import string", "meta.export string"],
      "settings": { "foreground": "#846E15" }
    },
    {
      "scope": ["source.css support.type.property-name", "source.sass support.type.property-name", "source.scss support.type.property-name", "source.less support.type.property-name"],
      "settings": { "foreground": "#036A96" }
    },
    {
      "scope": ["meta.selector", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#A3144D" }
    },
    {
      "scope": ["support.constant.property-value", "support.constant.font-name", "support.constant.media-type"],
      "settings": { "foreground": "#644AC9" }
    }
  ],
  "semanticTokenColors": {
    "parameter": { "foreground": "#A34D14", "fontStyle": "italic" },
    "property": "#1F1F1F",
    "property.readonly": "#1F1F1F",
    "variable.readonly": "#644AC9",
    "variable.readonly.defaultLibrary": "#644AC9",
    "function.defaultLibrary": "#14710A",
    "namespace": { "foreground": "#036A96", "fontStyle": "italic" },
    "type": "#036A96",
    "type.defaultLibrary": "#036A96",
    "interface": { "foreground": "#036A96", "fontStyle": "italic" },
    "enum": "#644AC9",
    "enumMember": "#644AC9",
    "decorator": { "foreground": "#14710A", "fontStyle": "italic" },
    "selfKeyword": { "foreground": "#644AC9", "fontStyle": "italic" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
