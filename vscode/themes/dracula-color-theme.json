  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#6272a4"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.block.documentation punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "scope": ["constant.character.escape", "string.escape"],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": ["string.regexp", "string.regex"],
      "settings": {
        "foreground": "#ff5555"
      }
    },
    {
      "scope": ["string.other.link", "string.other.symbol"],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#bd93f9"
      }
    },
    {
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"],
